# GEMINI_API_KEY: Required for dynamic Gemini AI API calls.
# In Google AI Studio, this is automatically injected into the container environment.
# When pulling/cloning this repository to localhost:
# 1. Copy this file: cp .env.example .env
# 2. Get a free API key at https://aistudio.google.com
# 3. Paste your key below:
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# On localhost, this defaults to http://localhost:3000
APP_URL="http://localhost:3000"

